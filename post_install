SCRIPT_DIR="$(cd "$(dirname "$0")" || exit; pwd)"
cd "$SCRIPT_DIR" || exit

set -o pipefail

KEYCLOAK_URL="http://localhost:8287"
CERT=$(curl -fsS "${KEYCLOAK_URL}/realms/CDIM/protocol/openid-connect/certs" | jq -r '.keys[] | select(.alg == "RS256") | .x5c | first') || exit 121
openssl x509 -in <(echo -n "${CERT}" | base64 -d) -pubkey --nocert > "$SCRIPT_DIR/set-up-tools/gateway/tools/public_key.pem" || exit 121

cd "$SCRIPT_DIR/set-up-tools/gateway/tools"
chmod +x initial_setup.sh

cd "$SCRIPT_DIR/set-up-tools"
docker compose up -d --build || exit 122
docker wait gateway-set-up-tools

cd "$SCRIPT_DIR/base-compose"
docker compose down gateway-dapr
docker compose down gateway
docker compose up -d --build || exit 123
